[
  {
    "field": "Country",
    "Save_to": "state.country_id",
    "processing": "",
    "mode": "select",
    "regex": "",
    "input_src": {
      "refers_to": "country",
      "condition": "country.country_gdp > 1600",
      "display": ["country_gdp"]
    }
  },
   {
    "field": "Name",
    "Save_to": "state.state_name",
    "processing": "",
    "mode": "input",
    "regex": "[a-zA-Z]+"
  },
  {
    "field": "GDP",
    "Save_to": "state.state_gdp",
    "processing": "",
    "mode": "calculated",
	"formula":"a*3+2000",
	"dependents":"country_gdp",
    "regex": "[0-9]+"
  }
]
