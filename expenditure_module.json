      "refers_to": "paytype",
     
		  "condition":  "paytype.paytype_id=1000003 or paytype.paytype_id=1000002",
      "display": ["paytype_name"]
    }
  },
  {
    "field": "Shop",
    "Save_to": "expenditure.shop_id",
    "processing": "",
    "mode": "select",
    "regex": "",
