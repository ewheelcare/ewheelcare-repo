    "Save_to": "expenditure.date",
    "processing": "",
    "mode": "date",
    "regex": "[a-zA-Z0-9-]+"
  },
  
  {
    "field": "Amount",
    "Save_to": "expenditure.amount",
    "processing": "",
    "mode": "input",
    "regex": "[0-9.]+"
  },
  {
    "field": "Mode of Pyment",
    "Save_to": "expenditure.paytype_id",
    "processing": "",
